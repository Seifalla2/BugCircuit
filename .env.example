CT_AI_PORT=3210
CT_AI_DATA_DIR=./data

# OmniRoute gateway. Current upstream default API is http://localhost:20128/v1
# Use model=auto to let OmniRoute choose among connected providers and fallbacks.
CT_AI_OMNIROUTE_BASE_URL=http://localhost:20128/v1
CT_AI_OMNIROUTE_MODEL=auto
CT_AI_OMNIROUTE_API_KEY=

# Generic OpenAI-compatible aliases remain supported as a fallback configuration.
CT_AI_OPENAI_PROVIDER_ID=omniroute
CT_AI_OPENAI_BASE_URL=
CT_AI_OPENAI_MODEL=
CT_AI_OPENAI_API_KEY=
