CT_AI_PORT=3210
CT_AI_DATA_DIR=./data

# Free provider chain (priority order)
# Keep real secrets in the deployment environment, never commit them.
OPENROUTER_API_KEY=
CT_AI_OPENROUTER_MODEL=openrouter/free

GROQ_API_KEY=
CT_AI_GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=
CT_AI_GEMINI_MODEL=gemini-2.5-flash

# Optional self-hosted OmniRoute gateway
CT_AI_OMNIROUTE_BASE_URL=
CT_AI_OMNIROUTE_MODEL=auto
CT_AI_OMNIROUTE_API_KEY=

# Optional generic/OpenAI-compatible endpoint; OpenAI can be configured here later.
CT_AI_OPENAI_PROVIDER_ID=
CT_AI_OPENAI_BASE_URL=
CT_AI_OPENAI_MODEL=
CT_AI_OPENAI_API_KEY=
